# Secrets — every .env variant, no exceptions (Next.js uses .env.local etc.)
.env
.env.*
!.env.example

__pycache__/
*.py[cod]
.pytest_cache/
node_modules/
.next/
out/
dist/
*.db
*.sqlite3
*.log
.venv/
venv/
.DS_Store

# Generated data/caches (regenerated by ml/ scripts and app boot)
backend/data/*.jsonl
backend/data/seed_inbox.json
backend/data/seed_predictions.json

# Fitted models: large binaries, regenerated by ml/ scripts. The honesty
# artifacts next to them — backend/artifacts/eval.json and calibration.json —
# ARE committed on purpose; the Evaluation page reads them at runtime.
*.joblib
*.pkl
*.pt
*.safetensors
backend/artifacts/model/
ml/models/
ml/artifacts/

# notebook scratch
.ipynb_checkpoints/

# test / type-check caches
.pytest_cache/
.mypy_cache/
.pyre_cache/

# editor / OS junk
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

