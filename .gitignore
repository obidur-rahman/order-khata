# Prepared data. The splits and the seed pool ARE tracked (1.2 MB total): the
# deployed Space needs seed_inbox.json for its demo inbox, the tests need
# d1_test.jsonl, and the notebook regenerates all of them identically. Only the
# cache and the SQLite file are machine-local.
backend/data/seed_predictions.json

# Fitted models: `backend/artifacts/*.joblib` IS tracked (~5 MB). It is the
# shipped engine, and eval.json is only meaningful next to the model that
# produced it — a clone without it boots degraded and the engine-parity test
# cannot run. Everything else here is regenerable, so it stays out.
*.pkl
*.pt
*.safetensors
backend/artifacts/model/
ml/models/
ml/artifacts/

# notebook scratch
.ipynb_checkpoints/

# test / type-check caches
.pytest_cache/
.mypy_cache/
.pyre_cache/

